[config]
name="HamsterAR"
binary="HamsterAR.a"
initialization="hamster_ar_init"
deinitialization="hamster_ar_deinit"

[dependencies]
system=["UIKit.framework", "Foundation.framework", "AVFoundation.framework", "ARKit.framework", "RealityKit.framework", "QuartzCore.framework"]
linker_flags=["-ObjC", "-L/usr/lib/swift", "-L$(TOOLCHAIN_DIR)/usr/lib/swift/iphoneos"]

[plist]
UIApplicationSceneManifest:raw="
<dict>
	<key>UIApplicationSupportsMultipleScenes</key>
	<false/>
	<key>UISceneConfigurations</key>
	<dict>
		<key>UIWindowSceneSessionRoleApplication</key>
		<array>
			<dict>
				<key>UISceneConfigurationName</key>
				<string>Default Configuration</string>
				<key>UISceneDelegateClassName</key>
				<string>HamsterSceneDelegate</string>
			</dict>
		</array>
	</dict>
</dict>"
